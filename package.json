    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "autocannon": "^8.0.0",
