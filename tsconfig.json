{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./legacy/ts/dist",
    "rootDir": "./legacy/ts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["legacy/ts/**/*"],
  "exclude": ["node_modules", "dist", "legacy/ts/dist", "legacy/ts/tests", "legacy/ts/scripts"]
}
